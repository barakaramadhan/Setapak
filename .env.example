# ---------------------------------------------------------
# 100MILIONSEEK (opsional, direkomendasikan)
# Gratis 100.000.000 token per akun per hari (reset 00:00 UTC), OpenAI-compatible.
# Daftar & ambil API key: https://100milionseek.top/
# Docs: https://100milionseek.top/docs
# Bila dikonfigurasi, provider ini otomatis diprioritaskan (kecuali AI_PROVIDER_ORDER di-set).
# ---------------------------------------------------------
HUNDREDMILLIONSEEK_API_KEY=
# HUNDREDMILLIONSEEK_MODEL=deepseek-v4.1-flash-free

# ---------------------------------------------------------
# OLLAMA (opsional)
# Ollama lokal: gratis & open-source (jalan di komputer/server sendiri), tanpa API key.
# Butuh Ollama terpasang + model sudah di-pull (mis. `ollama pull llama3.2`).
# Endpoint OpenAI-compatible default: http://localhost:11434/v1
# Untuk Ollama Cloud/endpoint lain, isi OLLAMA_BASE_URL dan OLLAMA_API_KEY jika diperlukan.
# Isi minimal OLLAMA_MODEL atau OLLAMA_BASE_URL agar provider ini aktif.
# ---------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
# OLLAMA_API_KEY=

# ---------------------------------------------------------
# GEOAPIFY (opsional, untuk data lokasi/tempat)
# Geocoding & Places API: https://www.geoapify.com/ (perlu API key, ada free tier/kuota gratis terbatas).
# Jika diisi, SETAPAK memakai Geoapify untuk geocoding tujuan dan pencarian tempat (POI),
# dengan fallback ke OpenStreetMap/Google Places bila perlu.
# ---------------------------------------------------------
# GEOAPIFY_API_KEY=

# ---------------------------------------------------------
# AI LAINNYA (opsional / cadangan)
# Gemini: https://aistudio.google.com/apikey
# Groq: https://console.groq.com/keys
# OpenRouter: https://openrouter.ai/keys
# ---------------------------------------------------------
GEMINI_API_KEY=
# Versi lama gemini-2.5-flash sudah tidak tersedia untuk akun baru.
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ---------------------------------------------------------
# URUTAN PROVIDER (opsional)
# Default otomatis memprioritaskan provider yang dikonfigurasi:
# 100milionseek,ollama,groq,gemini,openrouter
# Bisa diganti misalnya:
# AI_PROVIDER_ORDER=ollama,100milionseek,gemini,groq,openrouter
# ---------------------------------------------------------
# Urutan provider AI (terbaik -> terjelek/cadangan). Provider tanpa key/konfigurasi aktif dilewati.
# AI_PROVIDER_ORDER=groq,gemini,100milionseek,openrouter,ollama

# ---------------------------------------------------------
# SUPABASE (opsional, tapi dipakai supaya hasil pencarian sama untuk semua user)
# Jalankan dulu supabase/schema.sql di SQL Editor Supabase.
# Pakai SECRET / SERVICE ROLE key (sb_secret_... atau JWT role=service_role).
# JANGAN pakai publishable/anon key, dan JANGAN taruh key ini di browser.
# ---------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------
# SUPABASE AUTH + TRIP (browser)
# URL + ANON/PUBLISHABLE key dipakai browser untuk login dan tabel trips.
# Aman dikirim ke browser: RLS di schema.sql yang membatasi data per user.
# JANGAN pakai service role key di sini. Kosongkan untuk mode lokal.
# ---------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------
# FOTO GOOGLE (opsional)
# Foto Places di-host Google butuh akun billing. Tanpa key ini, kartu pakai
# foto asli dari Wikimedia/sumber web bila ada, sisanya foto stok + tautan Maps.
# ---------------------------------------------------------
# GOOGLE_MAPS_API_KEY=
