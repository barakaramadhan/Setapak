# ---------------------------------------------------------
# AI UTAMA
# Dapatkan gratis di: https://aistudio.google.com/apikey
# ---------------------------------------------------------
GEMINI_API_KEY=
# Versi lama gemini-2.5-flash sudah tidak tersedia untuk akun baru.
GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------
# URUTAN PROVIDER (opsional)
# Default: Groq lebih dulu (cepat, gratis, tanpa token berpikir).
# Bisa diganti misalnya: gemini,groq,openrouter
# AI_PROVIDER_ORDER=groq,gemini,openrouter

# ---------------------------------------------------------
# CADANGAN OTOMATIS (opsional)
# Kalau provider utama timeout / kena limit 429, server otomatis coba yang ini.
# Groq: https://console.groq.com/keys
# OpenRouter: https://openrouter.ai/keys
# ---------------------------------------------------------
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ---------------------------------------------------------
# SUPABASE (opsional, tapi dipakai supaya hasil pencarian sama untuk semua user)
# Jalankan dulu supabase/schema.sql di SQL Editor Supabase.
# Pakai SECRET / SERVICE ROLE key (sb_secret_... atau JWT role=service_role).
# JANGAN pakai publishable/anon key, dan JANGAN taruh key ini di browser.
# ---------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------
# SUPABASE AUTH + TRIP (browser)
# URL + ANON/PUBLISHABLE key dipakai browser untuk login dan tabel trips.
# Aman dikirim ke browser: RLS di schema.sql yang membatasi data per user.
# JANGAN pakai service role key di sini. Kosongkan untuk mode lokal.
# ---------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------
# FOTO GOOGLE (opsional)
# Foto Places di-host Google butuh akun billing. Tanpa key ini, kartu pakai
# foto asli dari Wikimedia/sumber web bila ada, sisanya foto stok + tautan Maps.
# ---------------------------------------------------------
# GOOGLE_MAPS_API_KEY=
